# Database Configuration
MONGODB_URL=mongodb://your_username:your_password@localhost:27017/your_database?authSource=admin
DATABASE_NAME=your_database_name

# Application Configuration  
APP_NAME=FastAPI User Management API
DEBUG=True

# JWT Configuration (REQUIRED)
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-string-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: For MongoDB Atlas (cloud)
# MONGODB_URL=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/your_database?retryWrites=true&w=majority
