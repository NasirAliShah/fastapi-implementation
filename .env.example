# Database Type Selection
# Options: "postgresql" or "mongodb"
DB_TYPE=postgresql

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=learning

# JWT Configuration (REQUIRED)
SECRET_KEY=your-super-secret-key-minimum-32-characters-change-this-to-something-random-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
